{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace.
 ;; This vertical wraps THREE bespoke domain capability libraries with the
 ;; governed-actor layer rather than reimplementing their logic:
 ;;   kotoba-lang/logistics -- tracking-number structural contract
 ;;   kotoba-lang/omise     -- store opening-hours/pickup-availability
 ;;   kotoba-lang/okaimono  -- order lifecycle/dispatchability
 ;; This repo is standalone (forkable outside the workspace); the
 ;; :local/root paths only resolve inside the monorepo checkout -- a
 ;; standalone fork should override them with git coordinates.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
        ;; html/css を top-level で git 座標に固定する。推移依存(:local/root)と
        ;; jp-go-dds(:git/sha)で座標型が違うと tools.deps が版を比較できない。
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.html"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.css"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
        io.github.kotoba-lang/logistics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.logistics"}
        io.github.kotoba-lang/omise
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.omise"}
        io.github.kotoba-lang/okaimono
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.okaimono"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "courierops.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5).
  :render-html {:main-opts ["-m" "courierops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
